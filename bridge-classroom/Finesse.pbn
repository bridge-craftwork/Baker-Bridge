[Vulnerable "None"]
[Deal "W:KJ953.T6.Q84.T85 T42.A83.AT72.K64 Q8.QJ942.95.J972 A76.K75.KJ63.AQ3"]
[Declarer "S"]
[Contract "3NT"]
